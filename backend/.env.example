# Reading Comprehension Screener — Backend environment variables.
# Copy this file to `.env` and fill in the values. This file documents the
# required keys without exposing any secret values.

# PostgreSQL connection string for the Supabase pooler (IPv4). Required.
DATABASE_URL=

# API key for the AI provider used during evaluation. Required at runtime.
AI_API_KEY=

# Base URL of the AI provider's API endpoint.
AI_BASE_URL=

# Model identifier requested from the AI provider.
AI_MODEL=

# Comma-separated list of allowed CORS origins (e.g. the Vercel frontend URLs). Required.
CORS_ORIGINS=

# IANA timezone used for "today" calculations. Defaults to Asia/Manila when unset.
TIMEZONE=Asia/Manila
